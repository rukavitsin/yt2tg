#!/usr/bin/env perl
use v5.36;
use strict;
use warnings;
use FindBin qw($Bin);
use lib "$Bin/lib";
use Tgph::CLI;
use Tgph::ExitCodes;
use Tgph::Publish;

sub usage {
    print <<"HELP";
Usage: tgph-delete [OPTIONS] URL_OR_PATH [URL_OR_PATH...]

"Deletes" Telegraph pages by editing them to empty content.
Telegraph API has no delete endpoint; this replaces page content
with an empty array while keeping the title as "(deleted)".
Accepts full URLs (https://telegra.ph/My-Page-08-19) or bare paths.

Options:
  -h, --help                Show this help
  -V, --version             Show version
  -n, --dry-run             Print prepared API requests instead of editing
      --access-token TOKEN  Telegraph access token (or TGPH_ACCESS_TOKEN)
      --api-url URL         API base URL (default: https://api.telegra.ph)
      --timeout SECONDS     HTTP timeout in seconds (default: 30)
HELP
    return Tgph::ExitCodes::OK;
}

sub extract_path {
    my ($input) = @_;
    if ($input =~ m{^https?://telegra\.ph/(.+)$}) {
        return $1;
    }
    return $input;
}

my @argv = @ARGV;
my ($access_token, $api_url, $timeout);

my ($options, $exit) = Tgph::CLI::parse(
    \@argv,
    spec => [
        'access-token=s' => \$access_token,
        'api-url=s'      => \$api_url,
        'timeout=i'      => \$timeout,
    ],
);

if ($options->{help}) {
    exit usage();
}
if ($options->{version}) {
    exit Tgph::CLI::print_version();
}
exit $exit unless $exit == Tgph::ExitCodes::OK;

my $dry_run = $options->{dry_run} // $options->{'dry-run'};

$access_token //= $ENV{TGPH_ACCESS_TOKEN};
$api_url      //= 'https://api.telegra.ph';
$timeout      //= 30;

if (!@argv) {
    warn "tgph-delete: at least one URL or path is required\n";
    exit Tgph::ExitCodes::USAGE;
}

my @edits;
for my $arg (@argv) {
    my $path = extract_path($arg);
    push @edits, {
        path    => $path,
        title   => '(deleted)',
        content => [],
    };
}

my $requests = eval {
    Tgph::Publish::prepare_edit_requests(
        \@edits,
        access_token => $access_token,
    );
};
if ($@) {
    warn "tgph-delete: $@";
    exit Tgph::ExitCodes::INPUT;
}

if ($dry_run) {
    my $sanitized = Tgph::Publish::sanitize_requests($requests);
    binmode STDOUT, ':encoding(UTF-8)';
    print Tgph::JSON::encode($sanitized), "\n";
    exit Tgph::ExitCodes::OK;
}

if (!defined $access_token || !length $access_token) {
    warn "tgph-delete: access token is required (use --access-token or TGPH_ACCESS_TOKEN)\n";
    exit Tgph::ExitCodes::USAGE;
}

my $results = eval {
    Tgph::Publish::send_requests(
        $requests,
        api_url => $api_url,
        timeout => $timeout,
    );
};
if ($@) {
    my $message = $@;
    $message =~ s/\s+\z//;
    warn "tgph-delete: $message";
    exit Tgph::ExitCodes::API;
}

binmode STDOUT, ':encoding(UTF-8)';
for my $result (@$results) {
    if (ref($result) eq 'HASH' && defined $result->{url} && !ref($result->{url})) {
        print "$result->{url}\n";
    }
}

exit Tgph::ExitCodes::OK;
