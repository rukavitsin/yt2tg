#!/usr/bin/env perl
use v5.36;
use strict;
use warnings;
use FindBin qw($Bin);
use lib "$Bin/lib";
use Encode qw(decode encode FB_CROAK);
use Tgph::CLI;
use Tgph::ExitCodes;
use Tgph::IO;
use Tgph::JSON;
use Tgph::Markdown;

sub usage {
    print <<"HELP";
Usage: tgph-md2content [OPTIONS] [FILE]

Options:
  -h, --help            Show this help
  -V, --version         Show version
  -n, --dry-run         Do not perform changes
      --title-out FILE  Write front matter title to FILE (if present)
HELP
    return Tgph::ExitCodes::OK;
}

my @argv = @ARGV;
my $title_out;

my ($options, $exit) = Tgph::CLI::parse(
    \@argv,
    spec => [
        'title-out=s' => \$title_out,
    ],
);

exit $exit unless $exit == Tgph::ExitCodes::OK;

if ($options->{help}) {
    exit usage();
}

if ($options->{version}) {
    exit Tgph::CLI::print_version();
}

exit Tgph::ExitCodes::USAGE if @argv > 1;

my $bytes;

if (@argv) {
    my $file = $argv[0];

    open my $fh, '<:raw', $file
        or do {
            warn "tgph-md2content: cannot open '$file': $!\n";
            exit Tgph::ExitCodes::INPUT;
        };

    eval {
        $bytes = Tgph::IO::read_bytes($fh);
        1;
    } or do {
        warn "tgph-md2content: $@";
        close $fh;
        exit Tgph::ExitCodes::INPUT;
    };

    close $fh
        or do {
            warn "tgph-md2content: cannot close '$file': $!\n";
            exit Tgph::ExitCodes::INPUT;
        };
}
else {
    eval {
        $bytes = Tgph::IO::read_bytes(\*STDIN);
        1;
    } or do {
        warn "tgph-md2content: $@";
        exit Tgph::ExitCodes::INPUT;
    };
}

my $markdown = eval { decode('UTF-8', $bytes, FB_CROAK) };

if ($@) {
    warn "tgph-md2content: input is not valid UTF-8\n";
    exit Tgph::ExitCodes::INPUT;
}

my $result = eval { Tgph::Markdown::convert($markdown) };

if ($@) {
    warn "tgph-md2content: $@";
    exit Tgph::ExitCodes::INTERNAL;
}

my $content  = $result->{content};
my $metadata = $result->{metadata};

if (defined $title_out
    && ref($metadata) eq 'HASH'
    && defined $metadata->{title}
    && length $metadata->{title}) {

    open my $tfh, '>:raw', $title_out
        or do {
            warn "tgph-md2content: cannot write title file '$title_out': $!\n";
            exit Tgph::ExitCodes::OUTPUT;
        };

    print {$tfh} encode('UTF-8', $metadata->{title});

    close $tfh
        or do {
            warn "tgph-md2content: cannot close title file '$title_out': $!\n";
            exit Tgph::ExitCodes::OUTPUT;
        };

    $content = Tgph::Markdown::strip_leading_h1($content);
}

binmode STDOUT;
print Tgph::JSON::encode($content);

exit Tgph::ExitCodes::OK;
