#!/usr/bin/env perl
use v5.36;
use strict;
use warnings;
use FindBin qw($Bin);
use lib "$Bin/lib";
use Tgph::CLI;
use Tgph::ExitCodes;
use Tgph::IO;
use Tgph::JSON;
use Tgph::Pretty;

sub usage {
    print <<"HELP";
Usage: tgph-pretty [OPTIONS] [FILE]

Options:
  -h, --help       Show this help
  -V, --version    Show version
  -n, --dry-run    Do not perform changes
  -c, --compact    Output compact canonical JSON instead of pretty
HELP
    return Tgph::ExitCodes::OK;
}

my @argv = @ARGV;
my $compact_mode = 0;

my ($options, $exit) = Tgph::CLI::parse(
    \@argv,
    spec => [
        'compact|c' => \$compact_mode,
    ],
);

exit $exit unless $exit == Tgph::ExitCodes::OK;

if ($options->{help}) {
    exit usage();
}

if ($options->{version}) {
    exit Tgph::CLI::print_version();
}

exit Tgph::ExitCodes::USAGE if @argv > 1;

my $bytes;

if (@argv) {
    my $file = $argv[0];

    open my $fh, '<:raw', $file
        or do {
            warn "tgph-pretty: cannot open '$file': $!\n";
            exit Tgph::ExitCodes::INPUT;
        };

    eval {
        $bytes = Tgph::IO::read_bytes($fh);
        1;
    } or do {
        warn "tgph-pretty: $@";
        close $fh;
        exit Tgph::ExitCodes::INPUT;
    };

    close $fh
        or do {
            warn "tgph-pretty: cannot close '$file': $!\n";
            exit Tgph::ExitCodes::INPUT;
        };
}
else {
    eval {
        $bytes = Tgph::IO::read_bytes(\*STDIN);
        1;
    } or do {
        warn "tgph-pretty: $@";
        exit Tgph::ExitCodes::INPUT;
    };
}

my $data = eval { Tgph::JSON::decode_bytes($bytes) };

if ($@) {
    warn "tgph-pretty: invalid JSON\n";
    exit Tgph::ExitCodes::INPUT;
}

binmode STDOUT;

if ($compact_mode) {
    print Tgph::Pretty::compact($data);
}
else {
    print Tgph::Pretty::pretty($data);
}

exit Tgph::ExitCodes::OK;
