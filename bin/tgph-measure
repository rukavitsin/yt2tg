#!/usr/bin/env perl

use v5.36;
use strict;
use warnings;
use utf8;

use FindBin qw($Bin);
use lib "$Bin/lib";

use Tgph::CLI;
use Tgph::ExitCodes;
use Tgph::IO;

my @argv = @ARGV;
my ($options, $exit) = Tgph::CLI::parse(\@argv);

exit $exit unless $exit == Tgph::ExitCodes::OK;

if ($options->{help}) {
    exit Tgph::CLI::print_help('tgph-measure');
}

if ($options->{version}) {
    exit Tgph::CLI::print_version();
}

my $bytes;

if (@argv) {
    exit Tgph::ExitCodes::USAGE if @argv > 1;

    my $file = $argv[0];

    open my $fh, '<:raw', $file
        or do {
            warn "tgph-measure: cannot open '$file': $!\n";
            exit Tgph::ExitCodes::INPUT;
        };

    $bytes = Tgph::IO::byte_count($fh);

    close $fh
        or do {
            warn "tgph-measure: cannot close '$file': $!\n";
            exit Tgph::ExitCodes::INPUT;
        };
}
else {
    $bytes = Tgph::IO::byte_count(\*STDIN);
}

print "$bytes\n";

exit Tgph::ExitCodes::OK;
