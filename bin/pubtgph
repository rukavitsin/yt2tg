#!/bin/sh
# pubtgph — full pipeline: markdown -> Telegra.ph
# POSIX sh (dash). No bashisms. Minimal forks.

set -eu

PROG='pubtgph'
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BIN_DIR=$SCRIPT_DIR

DEFAULT_MAX_BYTES=24000
EX_USAGE=1
EX_INPUT=2

die() {
    printf '%s: %s\n' "$PROG" "$2" >&2
    exit "$1"
}

version() {
    exec perl -I"$BIN_DIR/lib" -MTgph::CLI \
        -e 'exit Tgph::CLI::print_version()'
}

usage() {
    cat <<EOF
Usage: $PROG [OPTIONS] ARTICLE_MD

Pipeline: md2content -> normalize -> optimize -> validate -> split -> link -> publish -> (edit with nav)

If ARTICLE_MD has telegra_ph_url in front matter, edits existing page instead of creating new one.

Title priority: front matter -> h1 -> --title -> file name.

Options:
  -h, --help                Show this help
  -V, --version             Show version
  -t, --title TEXT          Fallback title
  -m, --max-bytes BYTES     Maximum page size (default: $DEFAULT_MAX_BYTES)
  -a, --author-name TEXT    Author name
  -u, --author-url URL      Author URL
      --access-token TOKEN  Telegraph token (default: \$TP_TOKEN from ~/.tgrc)
      --api-url URL         API base URL (default: \$TP_URL from ~/.tgrc)
  -n, --dry-run             Print prepared API requests without publishing
  -j, --json                Output full API results as JSON
      --no-navigation       Skip bidirectional navigation between pages
EOF
    exit 0
}

title=''
max_bytes=$DEFAULT_MAX_BYTES
author_name=''
author_url=''
access_token=''
api_url=''
dry_run=''
json_out=''
no_navigation=''
md_file=''

while [ $# -gt 0 ]; do
    case $1 in
        -h|--help)        usage ;;
        -V|--version)     version ;;
        -t|--title)       title=$2; shift 2 ;;
        -m|--max-bytes)   max_bytes=$2; shift 2 ;;
        -a|--author-name) author_name=$2; shift 2 ;;
        -u|--author-url)  author_url=$2; shift 2 ;;
        --access-token)   access_token=$2; shift 2 ;;
        --api-url)        api_url=$2; shift 2 ;;
        -n|--dry-run)     dry_run=1; shift ;;
        -j|--json)        json_out=1; shift ;;
        --no-navigation)  no_navigation=1; shift ;;
        -*)               die "$EX_USAGE" "unknown option: $1" ;;
        *)
            if [ -n "$md_file" ]; then
                die "$EX_USAGE" 'multiple input files not allowed'
            fi
            md_file=$1
            shift
            ;;
    esac
done

if [ -z "$md_file" ]; then
    die "$EX_USAGE" 'ARTICLE_MD file is required'
fi

if [ ! -f "$md_file" ]; then
    die "$EX_INPUT" "cannot open '$md_file'"
fi

# ─── Config: ~/.tgrc (CLI overrides) ────────────────────────────────────────
if [ -f "$HOME/.tgrc" ]; then
    . "$HOME/.tgrc"
fi

access_token=${access_token:-${TP_TOKEN:-}}
api_url=${api_url:-${TP_URL:-}}

# ─── Temp workspace ─────────────────────────────────────────────────────────
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

content=$WORK/content.json
normalized=$WORK/normalized.json
optimized=$WORK/optimized.json
pages=$WORK/pages.json
linked=$WORK/linked.json
fm_title=$WORK/fm_title.txt
h1_title=$WORK/h1_title.txt
fallback_title=$WORK/fallback_title.txt
JOURNAL_PATH="${XDG_DATA_HOME:-$HOME/.local/share}/pubtg/publish_log.jsonl"
mkdir -p "$(dirname "$JOURNAL_PATH")"
publish_results=$WORK/publish_results.json

# ─── 1. md -> content.json (+ front matter title) ───────────────────────────
"$BIN_DIR/tgph-md2content" --title-out "$fm_title" "$md_file" > "$content"

# ─── 2. normalize + title resolution ────────────────────────────────────────
if [ -s "$fm_title" ]; then
    "$BIN_DIR/tgph-normalize" "$content" > "$normalized"
    title_file=$fm_title
else
    "$BIN_DIR/tgph-normalize" --title-out "$h1_title" "$content" > "$normalized"

    if [ -s "$h1_title" ]; then
        title_file=$h1_title
    elif [ -n "$title" ]; then
        printf '%s' "$title" > "$fallback_title"
        title_file=$fallback_title
    else
        name=${md_file##*/}
        base=${name%.*}
        printf '%s' "$base" > "$fallback_title"
        title_file=$fallback_title
    fi
fi

# ─── 3. optimize -> validate -> split -> link ───────────────────────────────
"$BIN_DIR/tgph-optimize" "$normalized" > "$optimized"
"$BIN_DIR/tgph-validate" "$optimized"
"$BIN_DIR/tgph-split" --max-bytes "$max_bytes" "$optimized" > "$pages"
"$BIN_DIR/tgph-link" "$pages" > "$linked"

# ─── 4. Check for existing telegra_ph_url ───────────────────────────────────
existing_path=$(perl -I"$BIN_DIR/lib" -MTgph::FrontMatter -MTgph::IO -e '
    my $bytes = Tgph::IO::read_bytes(\*STDIN);
    my $path = Tgph::FrontMatter::extract_path($bytes);
    print $path if defined $path;
' < "$md_file")

page_count=$(perl -MJSON::PP -e '
    my $j = do { local $/; <STDIN> };
    my $data = JSON::PP->new->utf8->decode($j);
    print scalar @$data;
' < "$linked")

if [ -n "$existing_path" ] && [ "$page_count" -eq 1 ]; then
    # Edit existing single page instead of creating new one
    edit_json=$WORK/edit.json
    title_text=$(cat "$title_file")

    perl -MJSON::PP -e '
        my ($path, $title, $linked_file, $out_file) = @ARGV;
        open my $fh, "<:raw", $linked_file or die "cannot open $linked_file: $!";
        my $bytes = do { local $/; <$fh> };
        close $fh;
        my $pages = JSON::PP->new->utf8->decode($bytes);
        my $content = $pages->[0];
        my $edit = [{
            path => $path,
            title => $title,
            content => $content,
        }];
        open my $out, ">:raw", $out_file or die "cannot open $out_file: $!";
        print $out JSON::PP->new->utf8->encode($edit);
        close $out;
    ' "$existing_path" "$title_text" "$linked" "$edit_json"

    # Dry-run or json passthrough
    if [ -n "$dry_run" ]; then
        set --
        [ -n "$access_token" ] && set -- "$@" --access-token "$access_token"
        [ -n "$api_url" ] && set -- "$@" --api-url "$api_url"
        exec "$BIN_DIR/tgph-edit" --dry-run "$@" "$edit_json"
    fi

    if [ -n "$json_out" ]; then
        set --
        [ -n "$access_token" ] && set -- "$@" --access-token "$access_token"
        [ -n "$api_url" ] && set -- "$@" --api-url "$api_url"
        exec "$BIN_DIR/tgph-edit" --json "$@" "$edit_json"
    fi

    # Normal mode: call tgph-edit
    set --
    [ -n "$access_token" ] && set -- "$@" --access-token "$access_token"
    [ -n "$api_url" ] && set -- "$@" --api-url "$api_url"
    "$BIN_DIR/tgph-edit" "$@" "$edit_json" >/dev/null
    # Log edit to journal
    "$BIN_DIR/tgph-journal" append --journal "$JOURNAL_PATH" --record "$(perl -MJSON::PP -e 'print JSON::PP->new->canonical->encode({action=>"edit",source_file=>$ARGV[0],title=>$ARGV[1],path=>$ARGV[2],url=>"https://telegra.ph/$ARGV[2]"})' -- "$md_file" "$title_text" "$existing_path")"


    # Return URL (already exists in front matter)
    printf '%s\n' "https://telegra.ph/$existing_path"
    exit 0
fi

# ─── 5. publish (new pages) ─────────────────────────────────────────────────
set --

if [ -n "$author_name" ]; then
    set -- "$@" --author-name "$author_name"
fi

if [ -n "$author_url" ]; then
    set -- "$@" --author-url "$author_url"
fi

if [ -n "$access_token" ]; then
    set -- "$@" --access-token "$access_token"
fi

if [ -n "$api_url" ]; then
    set -- "$@" --api-url "$api_url"
fi

# Passthrough modes: dry-run and json behave exactly as before
if [ -n "$dry_run" ]; then
    set -- "$@" --dry-run
fi
if [ -n "$json_out" ]; then
    set -- "$@" --json
fi

if [ -n "$dry_run" ] || [ -n "$json_out" ]; then
    set -- "$@" --title-file "$title_file" "$linked"
    exec "$BIN_DIR/tgph-publish" "$@"
fi

# Normal mode: publish with --json to capture paths + urls
set -- "$@" --json --title-file "$title_file" "$linked"
"$BIN_DIR/tgph-publish" "$@" > "$publish_results"

# Log create to journal (each published page)
perl -MJSON::PP -MTgph::Journal -I"$BIN_DIR/lib" -e '
    my $j = do { local $/; <STDIN> };
    my $data = JSON::PP->new->utf8->decode($j);
    my $journal = $ARGV[0];
    my $source = $ARGV[1];
    for my $r (@$data) {
        next unless ref($r) eq "HASH" && defined $r->{url} && defined $r->{path};
        Tgph::Journal::append_record($journal, {
            action      => "create",
            source_file => $source,
            title       => $r->{title} // "",
            path        => $r->{path},
            url         => $r->{url},
        });
    }
' "$JOURNAL_PATH" "$md_file" < "$publish_results"

# Print URLs to stdout (backward compatible)
perl -MJSON::PP -e '
    my $j = do { local $/; <STDIN> };
    my $data = JSON::PP->new->utf8->decode($j);
    for my $r (@$data) {
        print "$r->{url}\n" if ref($r) eq "HASH" && defined $r->{url};
    }
' < "$publish_results"

# ─── 6. Add navigation if multiple pages ────────────────────────────────────
if [ -z "$no_navigation" ]; then
    page_count=$(perl -MJSON::PP -e '
        my $j = do { local $/; <STDIN> };
        my $data = JSON::PP->new->utf8->decode($j);
        print scalar @$data;
    ' < "$publish_results")

    if [ "$page_count" -gt 1 ]; then
        edits=$WORK/edits.json
        "$BIN_DIR/tgph-nav" --results "$publish_results" --title-file "$title_file" "$linked" > "$edits"

        edit_args=""
        [ -n "$access_token" ] && edit_args="--access-token $access_token"
        [ -n "$api_url" ] && edit_args="$edit_args --api-url $api_url"

        # shellcheck disable=SC2086
        "$BIN_DIR/tgph-edit" $edit_args "$edits" >/dev/null
    fi
fi
