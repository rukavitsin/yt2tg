#!/usr/bin/env perl
use v5.36;
use strict;
use warnings;
use utf8;
use FindBin qw($Bin);
use lib "$Bin/lib";
use JSON::PP ();
use Tgph::CLI;
use Tgph::ExitCodes;
use Yt2tg::Metadata;

my @argv = @ARGV;
my ($options, $exit) = Tgph::CLI::parse(\@argv);
exit $exit unless $exit == Tgph::ExitCodes::OK;

if ($options->{help}) {
    print <<"HELP";
Usage: yt2tg-meta VIDEO_ID
Extracts YouTube metadata (title, channel, date) via yt-dlp.
Accepts a 11-character video ID directly.
Options:
-h, --help       Show this help
-V, --version    Show version
HELP
    exit Tgph::ExitCodes::OK;
}
if ($options->{version}) {
    exit Tgph::CLI::print_version();
}

exit Tgph::ExitCodes::USAGE if @argv != 1;
my $video_id = $argv[0];

my $cmd = "yt-dlp -j --no-playlist " . quotemeta($video_id);
my $output = `$cmd 2>/dev/null`;
my $status = $? >> 8;

if ($status != 0 || !$output) {
    warn "yt2tg-meta: failed to fetch metadata from YouTube\n";
    exit Tgph::ExitCodes::API;
}

my $data = eval { JSON::PP::decode_json($output) };
if ($@ || ref($data) ne 'HASH') {
    warn "yt2tg-meta: invalid JSON from yt-dlp\n";
    exit Tgph::ExitCodes::INPUT;
}

my $title = Yt2tg::Metadata::clean_text($data->{title} // '');
my $channel = Yt2tg::Metadata::clean_text($data->{channel} // $data->{uploader} // '');
my $timestamp = $data->{timestamp};
my $date = Yt2tg::Metadata::format_time($timestamp);
my $date_short = Yt2tg::Metadata::format_date_short($timestamp);
my $id = $data->{id} // $video_id;
my $webpage_url = "http://youtu.be/$id";

my $title_fn = Yt2tg::Metadata::clean_filename_part($title);
my $channel_fn = Yt2tg::Metadata::clean_filename_part($channel);

# Use jq via pipe (not shell argument) to avoid "Argument list too long"
sub extract_lang_keys_jq {
    my ($raw_json, $section) = @_;

    # Build jq filter: .subtitles // {} | keys_unsorted[] | select(...)
    my $jq_filter = qq{.$section // {} | keys_unsorted[] | select(. != "live_chat" and test("^[a-z]{2,3}(-[a-zA-Z0-9]+)?$"))};

    # Open pipe to jq, write JSON to stdin
    my $jq = IO::File->new;
    $jq->open("|-") or return ();
    if (my $pid = open(my $child, '|-', 'jq', '-r', $jq_filter)) {
        binmode $child, ':raw';
        print $child $raw_json;
        close $child;
        waitpid $pid, 0;
    } else {
        # Fallback: use temporary file
    }

    # Simpler approach: open pipe, read output
    my @keys;
    my $pid = open(my $fh, '-|');
    return () unless defined $pid;

    if ($pid == 0) {
        # Child: run jq, feed JSON via stdin
        open(my $jq_fh, '|-', 'jq', '-r', $jq_filter) or exit 1;
        binmode $jq_fh, ':raw';
        print $jq_fh $raw_json;
        close $jq_fh;
        exit $? >> 8;
    }

    # Parent: read jq output
    while (my $line = <$fh>) {
        chomp $line;
        push @keys, $line if length $line;
    }
    close $fh;
    return @keys;
}

my @sub_keys = extract_lang_keys_jq($output, 'subtitles');
my @auto_keys = extract_lang_keys_jq($output, 'automatic_captions');

# Detect original language
my $original_lang = $data->{language};
if (!defined $original_lang || !length $original_lang) {
    for my $lang (@auto_keys) {
        if ($lang =~ /^([a-z]{2,3})-orig$/) {
            $original_lang = $1;
            last;
        }
    }
}

my $result = {
    video_id => $id,
    title => $title,
    channel => $channel,
    date => $date,
    date_short => $date_short,
    url => $webpage_url,
    title_fn => $title_fn,
    channel_fn => $channel_fn,
    language => $original_lang,
    subtitles => \@sub_keys,
    automatic_captions => \@auto_keys,
};

print JSON::PP->new->canonical->utf8->encode($result);
exit Tgph::ExitCodes::OK;
