#!/usr/bin/env perl
use v5.36;
use strict;
use warnings;
use utf8;
use FindBin qw($Bin);
use lib "$Bin/lib";
use JSON::PP ();
use Tgph::CLI;
use Tgph::ExitCodes;
use Yt2tg::Metadata;

my @argv = @ARGV;
my ($options, $exit) = Tgph::CLI::parse(\@argv);
exit $exit unless $exit == Tgph::ExitCodes::OK;

if ($options->{help}) {
    print <<"HELP";
Usage: yt2tg-meta VIDEO_ID
Extracts YouTube metadata (title, channel, date) via yt-dlp.
Accepts a 11-character video ID directly.
Options:
-h, --help       Show this help
-V, --version    Show version
HELP
    exit Tgph::ExitCodes::OK;
}
if ($options->{version}) {
    exit Tgph::CLI::print_version();
}

exit Tgph::ExitCodes::USAGE if @argv != 1;
my $video_id = $argv[0];

my $cmd = "yt-dlp -j --no-playlist " . quotemeta($video_id);
my $raw = `$cmd 2>/dev/null`;
my $status = $? >> 8;

if ($status != 0 || !$raw) {
    warn "yt2tg-meta: failed to fetch metadata from YouTube\n";
    exit Tgph::ExitCodes::API;
}

my $data = eval { JSON::PP::decode_json($raw) };
if ($@ || ref($data) ne 'HASH') {
    warn "yt2tg-meta: invalid JSON from yt-dlp\n";
    exit Tgph::ExitCodes::INPUT;
}

my $title = Yt2tg::Metadata::clean_text($data->{title} // '');
my $channel = Yt2tg::Metadata::clean_text($data->{channel} // $data->{uploader} // '');
my $timestamp = $data->{timestamp};
my $date = Yt2tg::Metadata::format_time($timestamp);
my $date_short = Yt2tg::Metadata::format_date_short($timestamp);
my $id = $data->{id} // $video_id;
my $webpage_url = "http://youtu.be/$id";

my $title_fn = Yt2tg::Metadata::clean_filename_part($title);
my $channel_fn = Yt2tg::Metadata::clean_filename_part($channel);

# Non-language keys to filter out
my %non_lang = map { $_ => 1 } qw(live_chat);

# Extract top-level keys from a JSON section (preserving order)
sub extract_top_level_keys {
    my ($raw_json, $section_name) = @_;
    my @keys;

    # Find "$section_name": {
    my $pattern = quotemeta("\"$section_name\"") . '\\s*:\\s*\\{';
    if ($raw_json =~ /$pattern/g) {
        my $start = pos($raw_json);
        # Find matching closing }
        my $depth = 1;
        my $i = $start;
        while ($depth > 0 && $i < length($raw_json)) {
            my $ch = substr($raw_json, $i, 1);
            if ($ch eq '{') { $depth++ }
            elsif ($ch eq '}') { $depth-- }
            $i++;
        }
        my $end = $i - 1;
        my $block = substr($raw_json, $start, $end - $start);

        # Parse top-level keys in block (track nesting depth)
        my $d = 0;
        my $j = 0;
        while ($j < length($block)) {
            my $ch = substr($block, $j, 1);
            if ($ch eq '{' || $ch eq '[') { $d++ }
            elsif ($ch eq '}' || $ch eq ']') { $d-- }
            elsif ($ch eq '"' && $d == 0) {
                # Top-level key
                if (substr($block, $j) =~ /^"([^"]+)"\s*:/) {
                    my $k = $1;
                    next if $non_lang{$k};
                    push @keys, $k unless grep { $_ eq $k } @keys;
                }
            }
            $j++;
        }
    }
    return @keys;
}

my @sub_keys = extract_top_level_keys($raw, 'subtitles');
my @auto_keys = extract_top_level_keys($raw, 'automatic_captions');

# Detect original language
my $original_lang = $data->{language};
if (!defined $original_lang || !length $original_lang) {
    for my $lang (@auto_keys) {
        if ($lang =~ /^([a-z]{2,3})-orig$/) {
            $original_lang = $1;
            last;
        }
    }
}

my $result = {
    video_id => $id,
    title => $title,
    channel => $channel,
    date => $date,
    date_short => $date_short,
    url => $webpage_url,
    title_fn => $title_fn,
    channel_fn => $channel_fn,
    language => $original_lang,
    subtitles => \@sub_keys,
    automatic_captions => \@auto_keys,
};

print JSON::PP->new->canonical->utf8->encode($result);
exit Tgph::ExitCodes::OK;
