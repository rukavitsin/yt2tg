#!/bin/sh
# yt2tg - full pipeline: YouTube -> Gemini -> Telegraph -> Telegram
# POSIX sh (dash). No bashisms. Minimal forks.
set -eu

PROG='yt2tg'
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BIN_DIR=$SCRIPT_DIR

EX_USAGE=1
EX_INPUT=2
EX_API=5
EX_OUTPUT=6

TOTAL_STEPS=7

die() {
    printf '%s: %s\n' "$PROG" "$2" >&2
    exit "$1"
}

step() {
    printf '[%s/%s] %s\n' "$1" "$TOTAL_STEPS" "$2" >&2
}

info() {
    printf '      %s\n' "$1" >&2
}

version() {
    exec perl -I"$BIN_DIR/lib" -MTgph::CLI \
        -e 'exit Tgph::CLI::print_version()'
}

usage() {
    cat <<EOF_USAGE
Usage: $PROG [OPTIONS] YOUTUBE_URL_OR_ID
Pipeline: yt-dlp -> Gemini -> Telegraph -> Telegram
Input: full YouTube URL or 11-character video ID
Options:
-h, --help            Show this help
-V, --version         Show version
-p, --prompt FILE     Prompt file (default: prompt.md)
-f, --force           Force republish even if video is in journal
EOF_USAGE
    exit 0
}

prompt_file='prompt.md'
force=''
input=''

while [ $# -gt 0 ]; do
    case $1 in
        -h|--help) usage ;;
        -V|--version) version ;;
        -p|--prompt) prompt_file=$2; shift 2 ;;
        -f|--force) force=1; shift ;;
        -*) die "$EX_USAGE" "unknown option: $1" ;;
        *)
            if [ -n "$input" ]; then
                die "$EX_USAGE" 'multiple inputs not allowed'
            fi
            input=$1
            shift
            ;;
    esac
done

if [ -z "$input" ]; then
    die "$EX_USAGE" 'YOUTUBE_URL_OR_ID is required'
fi

if printf '%s' "$input" | grep -qE '^[A-Za-z0-9_-]{11}$'; then
    video_id="$input"
else
    video_id=$(printf '%s' "$input" | perl -ne '
        if (m{(?:v=|youtu\.be/|/shorts/)([A-Za-z0-9_-]{11})}) { print $1; exit 0; }
        exit 1;
    ') || die "$EX_USAGE" "invalid YouTube URL or video ID"
fi

[ -s "$prompt_file" ] || die "$EX_INPUT" "prompt file '$prompt_file' is empty or missing"
command -v yt-dlp >/dev/null 2>&1 || die "$EX_USAGE" 'yt-dlp not found in PATH'
command -v cmark >/dev/null 2>&1 || die "$EX_USAGE" 'cmark not found in PATH'
command -v curl >/dev/null 2>&1 || die "$EX_USAGE" 'curl not found in PATH'
[ -f "$HOME/.tgrc" ] || die "$EX_INPUT" '~/.tgrc not found'
[ -f "$HOME/.geminirc" ] || die "$EX_INPUT" '~/.geminirc not found'

DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/pubtg"
mkdir -p "$DATA_DIR/srt" "$DATA_DIR/md"
SRT_DIR="$DATA_DIR/srt"
MD_DIR="$DATA_DIR/md"
JOURNAL="$DATA_DIR/publish_log.jsonl"

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
WORK=$(mktemp -d "$RUNTIME_DIR/yt2tg.XXXXXX")
trap 'rm -rf "$WORK"' EXIT

export PUBTG_INDENT=6

# --- 1. Extract metadata ---
step 1 'Extracting metadata'
meta_json=$WORK/meta.json
"$BIN_DIR/yt2tg-meta" "$video_id" > "$meta_json"

# Extract fields + thumbnail URL
perl -MJSON::PP -e '
    binmode STDOUT, ":utf8";
    open my $fh, "<:raw", $ARGV[0] or die "cannot open: $!";
    my $j = do { local $/; <$fh> };
    close $fh;
    my $d = JSON::PP->new->utf8->decode($j);
    print(($d->{video_id}   // ""), "\n");
    print(($d->{date_short} // ""), "\n");
    print(($d->{channel_fn} // ""), "\n");
    print(($d->{title_fn}   // ""), "\n");
    print(($d->{title}      // ""), "\n");
    print(($d->{channel}    // ""), "\n");
    print(($d->{thumbnail}  // ""), "\n");
' "$meta_json" > "$WORK/meta_fields.txt"

{
    IFS= read -r vid_id
    IFS= read -r date_short
    IFS= read -r channel_fn
    IFS= read -r title_fn
    IFS= read -r title
    IFS= read -r channel
    IFS= read -r thumb_url
} < "$WORK/meta_fields.txt"

if [ -z "$vid_id" ] || [ -z "$date_short" ] || \
   [ -z "$channel_fn" ] || [ -z "$title_fn" ]; then
    die "$EX_INPUT" 'failed to extract metadata fields'
fi

info "ID: $vid_id"

if [ -z "$force" ]; then
    if "$BIN_DIR/yt2tg-journal" check --journal "$JOURNAL" --video-id "$vid_id" >/dev/null 2>&1; then
        info "Already published. Use --force to republish."
        exit 0
    fi
fi

base_name="${date_short}--${vid_id}--${channel_fn}--${title_fn}"

# Download thumbnail (non-fatal: skip if fails)
thumb_file=""
if [ -n "$thumb_url" ]; then
    thumb_file="$WORK/thumb.jpg"
    if curl -sSfL --max-time 30 -o "$thumb_file" "$thumb_url" 2>/dev/null; then
        info "Thumbnail: $thumb_url"
    else
        info "Thumbnail download failed, will send as text message"
        rm -f "$thumb_file"
        thumb_file=""
    fi
fi

# --- 2. Download subtitles ---
step 2 'Downloading subtitles'
transcript=$("$BIN_DIR/yt2tg-subs" --output-dir "$WORK" --meta-file "$meta_json" "$vid_id")
if [ -z "$transcript" ] || [ ! -f "$transcript" ]; then
    die "$EX_INPUT" 'no subtitles found'
fi
[ -s "$transcript" ] || die "$EX_INPUT" 'transcript file is empty'
srt_file="${transcript%.txt}.srt"
cp "$transcript" "$SRT_DIR/${base_name}.txt"
if [ -f "$srt_file" ]; then
    cp "$srt_file" "$SRT_DIR/${base_name}.srt"
fi
info "Saved: $SRT_DIR/${base_name}.txt"

# --- 3. Send to Gemini ---
step 3 'Sending to Gemini'
response_md="$MD_DIR/${base_name}.md"
"$BIN_DIR/yt2tg-gemini" \
    --prompt-file "$prompt_file" \
    --transcript-file "$transcript" \
    --output-file "$response_md"
grep -q '### 1\.' "$response_md" || die "$EX_API" 'Gemini response missing section 1 heading'
grep -q '### 2\.' "$response_md" || die "$EX_API" 'Gemini response missing section 2 heading'
info "Saved: $response_md"

# --- 4. Split markdown ---
step 4 'Splitting markdown'
"$BIN_DIR/yt2tg-split-md" --out-dir "$WORK" "$response_md" >/dev/null
info "$WORK/section1.md"
info "$WORK/section234.md"
[ -s "$WORK/section1.md" ] || die "$EX_INPUT" 'section1.md is empty'
[ -s "$WORK/section234.md" ] || die "$EX_INPUT" 'section234.md is empty'

# --- 5. Build Telegraph markdown ---
step 5 'Building Telegraph markdown'
telegraph_md=$WORK/telegraph.md
"$BIN_DIR/yt2tg-telegraph" \
    --meta "$meta_json" \
    --section234 "$WORK/section234.md" > "$telegraph_md"

# --- 6. Publish to Telegraph ---
step 6 'Publishing to Telegraph'
"$BIN_DIR/pubtgph" --tool yt2tg "$telegraph_md" > "$WORK/telegraph_urls.txt"
telegraph_url=$(head -1 "$WORK/telegraph_urls.txt")
case "$telegraph_url" in
    https://telegra.ph/*) ;;
    *) die "$EX_API" 'invalid Telegraph URL' ;;
esac
info "URL: $telegraph_url"

# --- 7. Publish to Telegram ---
step 7 'Publishing to Telegram'
if [ -n "$thumb_file" ] && [ -f "$thumb_file" ]; then
    tg_output=$("$BIN_DIR/yt2tg-tg" \
        --meta "$meta_json" \
        --section1 "$WORK/section1.md" \
        --telegraph-url "$telegraph_url" \
        --thumbnail "$thumb_file")
else
    tg_output=$("$BIN_DIR/yt2tg-tg" \
        --meta "$meta_json" \
        --section1 "$WORK/section1.md" \
        --telegraph-url "$telegraph_url")
fi
case "$tg_output" in
    message_id=*) ;;
    *) die "$EX_API" 'Telegram publish did not return message_id' ;;
esac
message_id="${tg_output#message_id=}"
info "Telegram message_id: $message_id"

# --- Post-checks ---
[ -f "$SRT_DIR/${base_name}.txt" ] || die "$EX_OUTPUT" 'transcript txt artifact missing'
[ -f "$MD_DIR/${base_name}.md" ] || die "$EX_OUTPUT" 'response md artifact missing'

published_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
journal_record=$(VIDEO_ID="$vid_id" DATE_SHORT="$date_short" TITLE="$title" CHANNEL="$channel" TELEGRAPH_URL="$telegraph_url" MESSAGE_ID="$message_id" PUBLISHED_AT="$published_at" perl -MJSON::PP -MEncode -e '
    sub env_utf8 {
        my ($key) = @_;
        my $val = $ENV{$key} // "";
        return eval { Encode::decode("UTF-8", $val, Encode::FB_CROAK) } // $val;
    }
    my $record = {
        video_id => env_utf8("VIDEO_ID"),
        date_short => env_utf8("DATE_SHORT"),
        title => env_utf8("TITLE"),
        channel => env_utf8("CHANNEL"),
        telegraph_url => env_utf8("TELEGRAPH_URL"),
        telegram_message_id => env_utf8("MESSAGE_ID"),
        published_at => env_utf8("PUBLISHED_AT"),
        status => "success",
        tool => "yt2tg",
    };
    binmode STDOUT, ":utf8";
    print JSON::PP->new->encode($record);
')
"$BIN_DIR/yt2tg-journal" append --journal "$JOURNAL" --record "$journal_record"
info "Journal record appended"

printf '%s\n' "$telegraph_url"
