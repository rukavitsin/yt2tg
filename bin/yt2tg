#!/bin/sh
# yt2tg - full pipeline: YouTube -> Gemini -> Telegraph -> Telegram
# POSIX sh (dash). No bashisms. Minimal forks.
set -eu

PROG='yt2tg'
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BIN_DIR=$SCRIPT_DIR

EX_USAGE=1
EX_INPUT=2
EX_API=5

TOTAL_STEPS=7

die() {
    printf '%s: %s\n' "$PROG" "$2" >&2
    exit "$1"
}

step() {
    printf '[%s/%s] %s\n' "$1" "$TOTAL_STEPS" "$2" >&2
}

info() {
    printf '      %s\n' "$1" >&2
}

version() {
    exec perl -I"$BIN_DIR/lib" -MTgph::CLI \
        -e 'exit Tgph::CLI::print_version()'
}

usage() {
    cat <<EOF_USAGE
Usage: $PROG [OPTIONS] YOUTUBE_URL
Pipeline: yt-dlp -> Gemini -> Telegraph -> Telegram
Options:
-h, --help            Show this help
-V, --version         Show version
-p, --prompt FILE     Prompt file (default: prompt.md)
-f, --force           Force republish even if video is in journal
EOF_USAGE
    exit 0
}

prompt_file='prompt.md'
force=''
url=''

while [ $# -gt 0 ]; do
    case $1 in
        -h|--help) usage ;;
        -V|--version) version ;;
        -p|--prompt) prompt_file=$2; shift 2 ;;
        -f|--force) force=1; shift ;;
        -*) die "$EX_USAGE" "unknown option: $1" ;;
        *)
            if [ -n "$url" ]; then
                die "$EX_USAGE" 'multiple URLs not allowed'
            fi
            url=$1
            shift
            ;;
    esac
done

if [ -z "$url" ]; then
    die "$EX_USAGE" 'YOUTUBE_URL is required'
fi

# --- Pre-checks (user input first, then environment) ---
# P6: URL validation
case "$url" in
    http://www.youtube.com/*|https://www.youtube.com/*|http://youtube.com/*|https://youtube.com/*|http://youtu.be/*|https://youtu.be/*|http://m.youtube.com/*|https://m.youtube.com/*) ;;
    *) die "$EX_USAGE" 'invalid YouTube URL' ;;
esac
# P5: prompt file
[ -s "$prompt_file" ] || die "$EX_INPUT" "prompt file '$prompt_file' is empty or missing"
# P1: yt-dlp
command -v yt-dlp >/dev/null 2>&1 || die "$EX_USAGE" 'yt-dlp not found in PATH'
# P2: cmark
command -v cmark >/dev/null 2>&1 || die "$EX_USAGE" 'cmark not found in PATH'
# P3/P4: config files
[ -f "$HOME/.tgrc" ] || die "$EX_INPUT" '~/.tgrc not found'
[ -f "$HOME/.geminirc" ] || die "$EX_INPUT" '~/.geminirc not found'

# --- XDG Data directories ---
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/pubtg"
mkdir -p "$DATA_DIR/srt" "$DATA_DIR/md"
SRT_DIR="$DATA_DIR/srt"
MD_DIR="$DATA_DIR/md"
JOURNAL="$BIN_DIR/publish_log.jsonl"

# Temp workspace
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

# --- 1. Extract metadata ---
step 1 'Extracting metadata'
meta_json=$WORK/meta.json
"$BIN_DIR/yt2tg-meta" "$url" > "$meta_json"

perl -MJSON::PP -e '
    binmode STDOUT, ":utf8";
    open my $fh, "<:raw", $ARGV[0] or die "cannot open: $!";
    my $j = do { local $/; <$fh> };
    close $fh;
    my $d = JSON::PP->new->utf8->decode($j);
    print(($d->{video_id}   // ""), "\n");
    print(($d->{date_short} // ""), "\n");
    print(($d->{channel_fn} // ""), "\n");
    print(($d->{title_fn}   // ""), "\n");
' "$meta_json" > "$WORK/meta_fields.txt"

{
    IFS= read -r video_id
    IFS= read -r date_short
    IFS= read -r channel_fn
    IFS= read -r title_fn
} < "$WORK/meta_fields.txt"

if [ -z "$video_id" ] || [ -z "$date_short" ] || \
   [ -z "$channel_fn" ] || [ -z "$title_fn" ]; then
    die "$EX_INPUT" 'failed to extract metadata fields'
fi

info "ID: $video_id"

# P7: Journal check
if [ -z "$force" ]; then
    if "$BIN_DIR/yt2tg-journal" check --journal "$JOURNAL" --video-id "$video_id" >/dev/null 2>&1; then
        info "Already published. Use --force to republish."
        exit 0
    fi
fi

base_name="${date_short}--${video_id}--${channel_fn}--${title_fn}"

# --- 2. Download subtitles ---
step 2 'Downloading subtitles'
transcript=$("$BIN_DIR/yt2tg-subs" --output-dir "$WORK" "$url")
if [ -z "$transcript" ] || [ ! -f "$transcript" ]; then
    die "$EX_INPUT" 'no subtitles found'
fi
srt_file="${transcript%.txt}.srt"
cp "$transcript" "$SRT_DIR/${base_name}.txt"
if [ -f "$srt_file" ]; then
    cp "$srt_file" "$SRT_DIR/${base_name}.srt"
fi
info "Saved: $SRT_DIR/${base_name}.txt"

# --- 3. Send to Gemini ---
step 3 'Sending to Gemini'
response_md="$MD_DIR/${base_name}.md"
"$BIN_DIR/yt2tg-gemini" \
    --prompt-file "$prompt_file" \
    --transcript-file "$transcript" \
    --output-file "$response_md"
info "Saved: $response_md"

# --- 4. Split markdown ---
step 4 'Splitting markdown'
"$BIN_DIR/yt2tg-split-md" --out-dir "$WORK" "$response_md"

# --- 5. Build Telegraph markdown ---
step 5 'Building Telegraph markdown'
telegraph_md=$WORK/telegraph.md
"$BIN_DIR/yt2tg-telegraph" \
    --meta "$meta_json" \
    --section234 "$WORK/section234.md" > "$telegraph_md"

# --- 6. Publish to Telegraph ---
step 6 'Publishing to Telegraph'
"$BIN_DIR/pubtgph" "$telegraph_md" > "$WORK/telegraph_urls.txt"
telegraph_url=$(head -1 "$WORK/telegraph_urls.txt")

if [ -z "$telegraph_url" ]; then
    die "$EX_API" 'Telegraph publish returned no URL'
fi
info "URL: $telegraph_url"

# --- 7. Publish to Telegram ---
step 7 'Publishing to Telegram'
"$BIN_DIR/yt2tg-tg" \
    --meta "$meta_json" \
    --section1 "$WORK/section1.md" \
    --telegraph-url "$telegraph_url"

printf '%s\n' "$telegraph_url"
