#!/usr/bin/env perl
use v5.36;
use strict;
use warnings;
use utf8;
use FindBin qw($Bin);
use lib "$Bin/lib";
use Encode qw(decode encode FB_CROAK);
use Tgph::CLI;
use Tgph::ExitCodes;
use Tgph::IO;
use Yt2tg::SplitMd;

sub read_utf8 {
    my ($path) = @_;
    open my $fh, '<:raw', $path or return undef;
    my $bytes = eval { Tgph::IO::read_bytes($fh) };
    close $fh or return undef;
    return undef if $@;
    my $text = eval { decode('UTF-8', $bytes, FB_CROAK) };
    return undef if $@;
    return $text;
}

sub write_utf8 {
    my ($path, $text) = @_;
    open my $fh, '>:raw', $path or return 0;
    my $ok = print {$fh} encode('UTF-8', $text);
    close $fh or return 0;
    return $ok;
}

my @argv = @ARGV;
my $out_dir;
my ($options, $exit) = Tgph::CLI::parse(
    \@argv,
    spec => [
        'out-dir|o=s' => \$out_dir,
    ],
);
exit $exit unless $exit == Tgph::ExitCodes::OK;

if ($options->{help}) {
    print <<'HELP';
Usage: yt2tg-split-md --out-dir DIR [FILE]
Splits Gemini markdown response into section1.md and section234.md.
Options:
-h, --help       Show this help
-V, --version    Show version
-o, --out-dir DIR  Output directory (required)
HELP
    exit Tgph::ExitCodes::OK;
}
if ($options->{version}) {
    exit Tgph::CLI::print_version();
}

if (!defined $out_dir || !length $out_dir) {
    warn "yt2tg-split-md: --out-dir is required\n";
    exit Tgph::ExitCodes::USAGE;
}

exit Tgph::ExitCodes::USAGE if @argv > 1;

my $bytes;
if (@argv) {
    my $file = $argv[0];
    open my $fh, '<:raw', $file or do {
        warn "yt2tg-split-md: cannot open '$file': $!\n";
        exit Tgph::ExitCodes::INPUT;
    };
    eval {
        $bytes = Tgph::IO::read_bytes($fh);
        1;
    } or do {
        warn "yt2tg-split-md: $@";
        close $fh;
        exit Tgph::ExitCodes::INPUT;
    };
    close $fh or do {
        warn "yt2tg-split-md: cannot close '$file': $!\n";
        exit Tgph::ExitCodes::INPUT;
    };
}
else {
    eval {
        $bytes = Tgph::IO::read_bytes(\*STDIN);
        1;
    } or do {
        warn "yt2tg-split-md: $@";
        exit Tgph::ExitCodes::INPUT;
    };
}

my $markdown = eval { decode('UTF-8', $bytes, FB_CROAK) };
if ($@) {
    warn "yt2tg-split-md: input is not valid UTF-8\n";
    exit Tgph::ExitCodes::INPUT;
}

my $result = eval { Yt2tg::SplitMd::split_sections($markdown) };
if ($@) {
    warn "yt2tg-split-md: $@";
    exit Tgph::ExitCodes::VALIDATION;
}

unless (-d $out_dir) {
    mkdir $out_dir or do {
        warn "yt2tg-split-md: cannot create dir '$out_dir': $!\n";
        exit Tgph::ExitCodes::OUTPUT;
    };
}

my $file1 = "$out_dir/section1.md";
my $file234 = "$out_dir/section234.md";

if (!write_utf8($file1, $result->{section1})) {
    warn "yt2tg-split-md: cannot write '$file1': $!\n";
    exit Tgph::ExitCodes::OUTPUT;
}
if (!write_utf8($file234, $result->{section234})) {
    warn "yt2tg-split-md: cannot write '$file234': $!\n";
    exit Tgph::ExitCodes::OUTPUT;
}

print "$file1\n$file234\n";
exit Tgph::ExitCodes::OK;
