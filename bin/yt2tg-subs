#!/usr/bin/env perl
use v5.36;
use strict;
use warnings;
use FindBin qw($Bin);
use lib "$Bin/lib";
use Tgph::CLI;
use Tgph::ExitCodes;

my @argv = @ARGV;
my $output_dir = 'srt';
my ($options, $exit) = Tgph::CLI::parse(
    \@argv,
    spec => [
        'output-dir|o=s' => \$output_dir,
    ],
);
exit $exit unless $exit == Tgph::ExitCodes::OK;

if ($options->{help}) {
    print <<"HELP";
Usage: yt2tg-subs [OPTIONS] URL
Downloads and cleans YouTube subtitles via yt-dlp.
Options:
-h, --help            Show this help
-V, --version         Show version
-o, --output-dir DIR  Output directory for subtitles (default: srt)
HELP
    exit Tgph::ExitCodes::OK;
}
if ($options->{version}) {
    exit Tgph::CLI::print_version();
}

exit Tgph::ExitCodes::USAGE if @argv != 1;
my $url = $argv[0];

mkdir $output_dir unless -d $output_dir;

my @langs = ('original', 'en', 'ru', 'uk');
my $vtt_file;

for my $lang (@langs) {
    my $cmd = "yt-dlp --write-auto-subs --write-subs --sub-langs '$lang' --sub-format vtt --skip-download -o '$output_dir/%(id)s.%(ext)s' " . quotemeta($url);
    my $output = `$cmd 2>&1`;
    my $status = $? >> 8;

    if ($status == 0) {
        my @files = glob("$output_dir/*.vtt");
        if (@files) {
            $vtt_file = $files[0];
            last;
        }
    }
}

if (!defined $vtt_file || !-f $vtt_file) {
    warn "yt2tg-subs: no subtitles found for any language\n";
    exit Tgph::ExitCodes::INPUT;
}

open my $fh, '<:encoding(UTF-8)', $vtt_file or do {
    warn "yt2tg-subs: cannot read '$vtt_file': $!\n";
    exit Tgph::ExitCodes::INPUT;
};
my $text = do { local $/; <$fh> };
close $fh;

my $cleaned = clean_vtt($text);

my $txt_file = $vtt_file;
$txt_file =~ s/\.vtt$/.txt/;
open my $out, '>:encoding(UTF-8)', $txt_file or do {
    warn "yt2tg-subs: cannot write '$txt_file': $!\n";
    exit Tgph::ExitCodes::OUTPUT;
};
print $out $cleaned;
close $out;

print "$txt_file\n";
exit Tgph::ExitCodes::OK;

sub clean_vtt {
    my ($text) = @_;
    my @lines = split /\n/, $text;
    my @result;
    my %seen;
    for my $line (@lines) {
        next if $line =~ /^WEBVTT/;
        next if $line =~ /^Kind:/;
        next if $line =~ /^Language:/;
        next if $line =~ /^\d+$/;
        next if $line =~ /-->/;
        next if $line =~ /^\s*$/;

        $line =~ s/<[^>]+>//g;
        $line =~ s/\{[^}]+\}//g;
        $line =~ s/\[[^\]]+\]//g;
        $line =~ s/^\s+|\s+$//g;

        next if $line eq '';

        next if $seen{$line}++;

        push @result, $line;
    }
    return join("\n", @result);
}
