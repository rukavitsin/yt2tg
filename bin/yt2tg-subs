#!/usr/bin/env perl
use v5.36;
use strict;
use warnings;
use FindBin qw($Bin);
use lib "$Bin/lib";
use JSON::PP ();
use Tgph::CLI;
use Tgph::Diag qw(diag);
use Tgph::ExitCodes;

my @argv = @ARGV;
my $output_dir = 'srt';
my $custom_lang;
my $meta_file;
my ($options, $exit) = Tgph::CLI::parse(
    \@argv,
    spec => [
        'output-dir|o=s' => \$output_dir,
        'lang|l=s'       => \$custom_lang,
        'meta-file|m=s'  => \$meta_file,
    ],
);
exit $exit unless $exit == Tgph::ExitCodes::OK;

if ($options->{help}) {
    print <<"HELP";
Usage: yt2tg-subs [OPTIONS] URL
Downloads YouTube subtitles as SRT, converts to single-line TXT.
Options:
-h, --help            Show this help
-V, --version         Show version
-o, --output-dir DIR  Output directory for subtitles (default: srt)
-l, --lang LANG       Force specific language (skip fallback)
                      Examples: en, en.*, ru, uk, all
-m, --meta-file FILE  Metadata JSON from yt2tg-meta (for smart lang detection)
HELP
    exit Tgph::ExitCodes::OK;
}
if ($options->{version}) {
    exit Tgph::CLI::print_version();
}

exit Tgph::ExitCodes::USAGE if @argv != 1;
my $url = $argv[0];

mkdir $output_dir unless -d $output_dir;

sub d { diag(@_, prefix => 'yt2tg-subs: ') }

my @langs;
if (defined $custom_lang && length $custom_lang) {
    @langs = ($custom_lang);
    d("Using custom language: $custom_lang");
} else {
    my @priority_langs;

    if (defined $meta_file && -f $meta_file) {
        open my $mfh, '<:raw', $meta_file or d("cannot open meta file: $!");
        if ($mfh) {
            my $json = do { local $/; <$mfh> };
            close $mfh;
            my $meta = eval { JSON::PP->new->utf8->decode($json) };
            if (!$@ && ref($meta) eq 'HASH') {
                if (defined $meta->{language} && length $meta->{language}) {
                    push @priority_langs, $meta->{language};
                    push @priority_langs, $meta->{language} . '-orig';
                }
                if (ref($meta->{subtitles}) eq 'ARRAY') {
                    push @priority_langs, @{$meta->{subtitles}};
                }
                if (ref($meta->{automatic_captions}) eq 'ARRAY') {
                    my @auto = @{$meta->{automatic_captions}};
                    push @priority_langs, splice(@auto, 0, 5);
                }
            }
        }
    }

    my %seen;
    @priority_langs = grep { !$seen{$_}++ } @priority_langs;

    my @fallback = ('en', 'en.*', 'ru', 'ru.*', 'uk', 'uk.*', 'all');
    @langs = (@priority_langs, @fallback);
    %seen = ();
    @langs = grep { !$seen{$_}++ } @langs;

    d("Priority: " . join(', ', @priority_langs)) if @priority_langs;
}

my $srt_file;

for my $lang (@langs) {
    d("Trying language: $lang");
    my $cmd = "yt-dlp --write-auto-subs --write-subs --sub-langs '$lang' --convert-subs srt --skip-download -o '$output_dir/%(id)s.%(ext)s' " . quotemeta($url);

    my $output = `$cmd 2>&1`;
    my $status = $? >> 8;

    if ($status != 0) {
        d("yt-dlp failed with status $status");
        d("stderr/stdout: $output") if $output =~ /\S/;
    }

    if ($status == 0) {
        my @files = glob("$output_dir/*.srt");
        if (@files) {
            $srt_file = $files[0];
            last;
        }
    }
}

if (!defined $srt_file || !-f $srt_file) {
    warn "yt2tg-subs: no subtitles found for any language\n";
    exit Tgph::ExitCodes::INPUT;
}

open my $fh, '<:encoding(UTF-8)', $srt_file or do {
    warn "yt2tg-subs: cannot read '$srt_file': $!\n";
    exit Tgph::ExitCodes::INPUT;
};
my $text = do { local $/; <$fh> };
close $fh;

my $cleaned = clean_srt($text);

my $txt_file = $srt_file;
$txt_file =~ s/\.srt$/.txt/;
open my $out, '>:encoding(UTF-8)', $txt_file or do {
    warn "yt2tg-subs: cannot write '$txt_file': $!\n";
    exit Tgph::ExitCodes::OUTPUT;
};
print $out $cleaned, "\n";
close $out;

print "$txt_file\n";
exit Tgph::ExitCodes::OK;

sub decode_entities {
    my ($text) = @_;
    $text =~ s/&nbsp;/ /g;
    $text =~ s/&lt;/</g;
    $text =~ s/&gt;/>/g;
    $text =~ s/&quot;/"/g;
    $text =~ s/&#x([0-9a-fA-F]+);/chr(hex($1))/ge;
    $text =~ s/&#([0-9]+);/chr($1)/ge;
    $text =~ s/&amp;/&/g;
    return $text;
}

sub clean_srt {
    my ($text) = @_;
    $text =~ s/^\x{FEFF}//;
    my @lines = split /\n/, $text;
    my @result;
    my %seen;
    for my $line (@lines) {
        next if $line =~ /^\d+$/;
        next if $line =~ /-->/;
        next if $line =~ /^\s*$/;

        $line =~ s/<[^>]+>//g;
        $line =~ s/\{[^}]+\}//g;
        $line =~ s/\[[^\]]+\]//g;
        $line = decode_entities($line);
        $line =~ s/^\s+|\s+$//g;

        next if $line eq '';
        next if $seen{$line}++;

        push @result, $line;
    }
    my $joined = join(' ', @result);
    $joined =~ s/\s+/ /g;
    $joined =~ s/^\s+|\s+$//g;
    return $joined;
}
